<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and newer: same scope as backup_rules.xml. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="FlutterSharedPreferences.xml" />
        <include domain="root" path="app_flutter/wildbit.sqlite" />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="FlutterSharedPreferences.xml" />
        <include domain="root" path="app_flutter/wildbit.sqlite" />
    </device-transfer>
</data-extraction-rules>
